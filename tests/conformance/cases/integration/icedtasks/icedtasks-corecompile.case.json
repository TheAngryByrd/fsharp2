      "comparison.json",
      "lanes/*/stdout.bin",
      "lanes/*/stderr.bin"
    ],
    "lateFailure": "compare-declared-leftovers"
  },
  "timeout": {
    "evaluationMs": 120000,
    "compileMs": 600000,
    "probeMs": 300000,
    "cleanupMs": 60000
  }
}
