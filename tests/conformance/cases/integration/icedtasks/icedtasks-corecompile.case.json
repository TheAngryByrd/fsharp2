        "fingerprintRequired": false,
        "traceRequired": true,
        "observableProofs": [
          "probe-load"
        ]
      },
      {
        "phase": "execution",
        "status": "not-run",
        "fingerprintRequired": false,
        "traceRequired": true,
        "observableProofs": [
          "probe-execution"
        ]
      }
    ]
  },
  "probes": [],
  "comparisons": [
    {
      "path": "lanes.compiler-selection",
      "class": "exact",
      "comparator": "diagnostic-exact",
      "rule": "compiler-selection-v1"
    },
    {
      "path": "lanes.paths",
      "class": "normalized",
      "comparator": "path-newline-normalized",
      "rule": "logical-root-v1"
    },
    {
      "path": "observations.artifacts",
      "class": "exact",
      "comparator": "diagnostic-exact",
      "rule": "publication-v1"
    }
  ],
  "cleanup": {
    "retention": "on-failure",
    "delete": [
      "lanes/*/tmp",
      "lanes/*/service",
      "lanes/*/cache"
    ],
    "retain": [
