{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theangrybyrd.github.io/fsharp2/conformance/schemas/v1/closure.schema.json",
  "title": "FSharp2 ordered reference closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "closureId", "family", "targetFramework", "references", "comparison", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "closureId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "targetFramework": { "type": "string", "minLength": 1 },
    "references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "comparison": { "const": "exact-ordered-closure" },
    "review": { "$ref": "#/$defs/review" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "stableId", "logicalPath", "sha256", "assemblyName", "version", "culture", "publicKeyToken", "evaluatedItemSource"],
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
        "logicalPath": { "type": "string", "pattern": "^/[^\\\\]+$" },
        "sha256": { "$ref": "#/$defs/hash" },
        "assemblyName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "culture": { "type": "string" },
        "publicKeyToken": { "type": "string", "pattern": "^([0-9a-f]{16}|null)$" },
        "evaluatedItemSource": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "sourceIssue", "refreshCondition"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "sourceIssue": { "type": "string", "pattern": "^#[0-9]+$" },
        "refreshCondition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
