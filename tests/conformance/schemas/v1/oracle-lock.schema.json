{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theangrybyrd.github.io/fsharp2/conformance/schemas/v1/oracle-lock.schema.json",
  "title": "FSharp2 Oracle diagnostic lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentKind", "schemaVersion", "lockId", "family", "caseId", "caseHash", "oracleIdentity", "streams", "process", "diagnostics", "artifacts", "review"],
  "properties": {
    "documentKind": { "const": "oracle-lock-v1" },
    "schemaVersion": { "const": 1 },
    "lockId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "caseHash": { "$ref": "#/$defs/hash" },
    "oracleIdentity": { "$ref": "#/$defs/oracleIdentity" },
    "streams": { "$ref": "#/$defs/streams" },
    "process": { "$ref": "#/$defs/process" },
    "diagnostics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/diagnostic" } },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "review": { "$ref": "#/$defs/review" },
    "diagnosticCompatibility": { "$ref": "#/$defs/diagnosticCompatibility" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$" },
    "logicalPath": { "type": "string", "pattern": "^/[^\\\\]+$" },
    "diagnosticCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "output", "occurrences"],
      "properties": {
        "request": { "$ref": "#/$defs/diagnosticRequest" },
        "output": { "$ref": "#/$defs/diagnosticOutput" },
        "occurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnosticOccurrence" }
        }
      }
    },
    "diagnosticRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warningLevel",
        "disabledWarnings",
        "enabledWarnings",
        "treatWarningsAsErrors",
        "warningsAsErrors",
        "warningsNotAsErrors",
        "maximumErrors",
        "abortOnError",
        "preferredUICulture",
        "localWarningDirectives"
      ],
      "properties": {
        "warningLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
        "disabledWarnings": { "$ref": "#/$defs/diagnosticCodes" },
        "enabledWarnings": { "$ref": "#/$defs/diagnosticCodes" },
        "treatWarningsAsErrors": { "type": "boolean" },
        "warningsAsErrors": { "$ref": "#/$defs/diagnosticCodes" },
        "warningsNotAsErrors": { "$ref": "#/$defs/diagnosticCodes" },
        "maximumErrors": { "type": "integer", "minimum": 1 },
        "abortOnError": { "type": "boolean" },
        "preferredUICulture": { "type": "string", "minLength": 1 },
        "localWarningDirectives": {
          "type": "array",
          "items": { "$ref": "#/$defs/localWarningDirective" }
        }
      }
    },
    "localWarningDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "logicalPath", "range", "scope"],
      "properties": {
        "kind": { "const": "nowarn" },
        "code": { "type": "string", "pattern": "^FS[0-9]{4}$" },
        "logicalPath": { "$ref": "#/$defs/logicalPath" },
        "range": { "$ref": "#/$defs/diagnosticRange" },
        "scope": { "enum": ["file", "line"] }
      }
    },
    "diagnosticCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^FS[0-9]{4}$" }
    },
    "diagnosticOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullPaths",
        "flatErrors",
        "utf8Output",
        "diagnosticStyle",
        "consoleColorMode",
        "lcid",
        "preferredUILanguage",
        "testParserErrorRecovery",
        "standardOutputRedirected",
        "standardErrorRedirected"
      ],
      "properties": {
        "fullPaths": { "type": "boolean" },
        "flatErrors": { "type": "boolean" },
        "utf8Output": { "type": "boolean" },
        "diagnosticStyle": { "enum": ["default", "visual-studio", "gcc", "rich", "flat"] },
        "consoleColorMode": { "enum": ["automatic", "enabled", "disabled"] },
        "lcid": { "type": ["integer", "null"], "minimum": 0 },
        "preferredUILanguage": { "type": ["string", "null"], "minLength": 1 },
        "testParserErrorRecovery": { "type": "boolean" },
        "standardOutputRedirected": { "type": "boolean" },
        "standardErrorRedirected": { "type": "boolean" }
      }
    },
    "diagnosticStage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "command-line" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "phase"],
          "properties": {
            "kind": { "const": "compilation" },
            "phase": {
              "enum": [
                "source",
                "syntax",
                "resolved-symbols",
                "typed-declarations",
                "lowered-code",
                "optimized-code",
                "symbolic-emission",
                "final-linking"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "publication" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "host" } }
        }
      ]
    },
    "diagnosticRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnosticRawBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "length", "sha256"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "diagnosticRelatedInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "logicalPath", "range"],
      "properties": {
        "message": { "type": "string" },
        "logicalPath": { "type": ["string", "null"], "pattern": "^/[^\\\\]+$" },
        "range": {
          "oneOf": [
            { "$ref": "#/$defs/diagnosticRange" },
            { "type": "null" }
          ]
        }
      }
    },
    "diagnosticOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence",
        "code",
        "numericCode",
        "subcategory",
        "stage",
        "originalSeverity",
        "effectiveSeverity",
        "disposition",
        "suppression",
        "message",
        "logicalPath",
        "materializedPath",
        "range",
        "relatedInformation",
        "suggestions",
        "recoveryGroup",
        "parentOccurrence",
        "rawBytes",
        "stream"
      ],
      "properties": {
        "occurrence": { "type": "integer", "minimum": 0 },
        "code": { "type": "string", "pattern": "^FS[0-9]{4}$" },
        "numericCode": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "subcategory": { "type": ["string", "null"] },
        "stage": { "$ref": "#/$defs/diagnosticStage" },
        "originalSeverity": { "enum": ["information", "warning", "error"] },
        "effectiveSeverity": { "enum": ["hidden", "information", "warning", "error"] },
        "disposition": { "enum": ["emitted", "suppressed"] },
        "suppression": {
          "type": ["string", "null"],
          "enum": [
            null,
            "warning-level",
            "global-nowarn",
            "local-nowarn",
            "off-by-default",
            "language-feature",
            "maximum-errors",
            "abort-boundary"
          ]
        },
        "message": { "type": "string" },
        "logicalPath": { "type": ["string", "null"], "pattern": "^/[^\\\\]+$" },
        "materializedPath": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "range": {
          "oneOf": [
            { "$ref": "#/$defs/diagnosticRange" },
            { "type": "null" }
          ]
        },
        "relatedInformation": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnosticRelatedInformation" }
        },
        "suggestions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recoveryGroup": { "type": ["string", "null"], "minLength": 1 },
        "parentOccurrence": { "type": ["integer", "null"], "minimum": 0 },
        "rawBytes": {
          "oneOf": [
            { "$ref": "#/$defs/diagnosticRawBytes" },
            { "type": "null" }
          ]
        },
        "stream": { "type": ["string", "null"], "enum": [null, "stdout", "stderr"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "suppressed" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "effectiveSeverity": { "const": "hidden" },
              "suppression": { "type": "string" },
              "rawBytes": { "type": "null" },
              "stream": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "emitted" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "effectiveSeverity": { "enum": ["information", "warning", "error"] },
              "suppression": { "type": "null" },
              "rawBytes": { "$ref": "#/$defs/diagnosticRawBytes" },
              "stream": { "enum": ["stdout", "stderr"] }
            }
          }
        }
      ]
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalPath", "sha256", "productVersion"],
      "properties": {
        "logicalPath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/hash" },
        "productVersion": { "type": "string", "minLength": 1 }
      }
    },
    "oracleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkVersion", "sdkCommit", "compiler", "msbuildTask", "fsharpCore", "culture", "encoding", "optionHash"],
      "properties": {
        "sdkVersion": { "const": "10.0.110" },
        "sdkCommit": { "const": "f7d90799ce4ef09a0bb257852a57248d2a8fb8dd" },
        "compiler": { "$ref": "#/$defs/toolIdentity" },
        "msbuildTask": { "$ref": "#/$defs/toolIdentity" },
        "fsharpCore": { "$ref": "#/$defs/toolIdentity" },
        "culture": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "minLength": 1 },
        "optionHash": { "$ref": "#/$defs/hash" }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base64", "byteLength", "byteHash", "text", "textHash"],
      "properties": {
        "base64": { "type": "string", "contentEncoding": "base64" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "byteHash": { "$ref": "#/$defs/hash" },
        "text": { "type": "string" },
        "textHash": { "$ref": "#/$defs/hash" }
      }
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "targetResult"],
      "properties": {
        "exitCode": { "type": "integer" },
        "targetResult": { "enum": ["succeeded", "failed"] }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "code", "subcategory", "originalSeverity", "adjustedSeverity", "message", "logicalSource", "range", "stream", "sequence", "occurrenceCount", "related", "warningLevel", "suppressed", "promoted", "languageGate", "recoveryContext"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
        "code": { "type": "string", "pattern": "^FS[0-9]{4}$" },
        "subcategory": { "type": "string" },
        "originalSeverity": { "enum": ["info", "warning", "error"] },
        "adjustedSeverity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "logicalSource": { "type": "string" },
        "range": { "$ref": "#/$defs/range" },
        "stream": { "enum": ["stdout", "stderr"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "occurrenceCount": { "type": "integer", "minimum": 1 },
        "related": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "warningLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
        "suppressed": { "type": "boolean" },
        "promoted": { "type": "boolean" },
        "languageGate": { "type": ["string", "null"] },
        "recoveryContext": { "type": "string" }
      }
    },
    "artifactEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalPath", "state", "sha256"],
      "properties": {
        "logicalPath": { "type": "string" },
        "state": { "enum": ["present", "absent"] },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preRun", "postRun"],
      "properties": {
        "preRun": { "type": "array", "items": { "$ref": "#/$defs/artifactEntry" } },
        "postRun": { "type": "array", "items": { "$ref": "#/$defs/artifactEntry" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "sourceIssue", "capturedAt", "expiryCondition"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "sourceIssue": { "type": "string", "pattern": "^#[0-9]+$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "expiryCondition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
