{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theangrybyrd.github.io/fsharp2/conformance/schemas/v1/run-result.schema.json",
  "title": "FSharp2 conformance run result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "environment", "inputs", "coreEvidence", "lanes", "observations", "comparisons", "verdict"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": { "$ref": "#/$defs/identity" },
    "environment": { "$ref": "#/$defs/environment" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "coreEvidence": { "$ref": "#/$defs/coreEvidence" },
    "lanes": { "$ref": "#/$defs/lanes" },
    "observations": { "$ref": "#/$defs/observations" },
    "comparisons": { "type": "array", "items": { "$ref": "#/$defs/comparison" } },
    "verdict": { "$ref": "#/$defs/verdict" },
    "diagnosticCompatibility": { "$ref": "#/$defs/diagnosticCompatibility" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$" },
    "logicalPath": { "type": "string", "pattern": "^/[^\\\\]+$" },
    "diagnosticCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "output", "occurrences"],
      "properties": {
        "request": { "$ref": "#/$defs/diagnosticRequest" },
        "output": { "$ref": "#/$defs/diagnosticOutput" },
        "occurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnosticOccurrence" }
        }
      }
    },
    "diagnosticRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warningLevel",
        "disabledWarnings",
        "enabledWarnings",
        "treatWarningsAsErrors",
        "warningsAsErrors",
        "warningsNotAsErrors",
        "maximumErrors",
        "abortOnError",
        "preferredUICulture",
        "localWarningDirectives"
      ],
      "properties": {
        "warningLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
        "disabledWarnings": { "$ref": "#/$defs/diagnosticCodes" },
        "enabledWarnings": { "$ref": "#/$defs/diagnosticCodes" },
        "treatWarningsAsErrors": { "type": "boolean" },
        "warningsAsErrors": { "$ref": "#/$defs/diagnosticCodes" },
        "warningsNotAsErrors": { "$ref": "#/$defs/diagnosticCodes" },
        "maximumErrors": { "type": "integer", "minimum": 1 },
        "abortOnError": { "type": "boolean" },
        "preferredUICulture": { "type": "string", "minLength": 1 },
        "localWarningDirectives": {
          "type": "array",
          "items": { "$ref": "#/$defs/localWarningDirective" }
        }
      }
    },
    "localWarningDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "logicalPath", "range", "scope"],
      "properties": {
        "kind": { "const": "nowarn" },
        "code": { "type": "string", "pattern": "^FS[0-9]{4}$" },
        "logicalPath": { "$ref": "#/$defs/logicalPath" },
        "range": { "$ref": "#/$defs/diagnosticRange" },
        "scope": { "enum": ["file", "line"] }
      }
    },
    "diagnosticCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^FS[0-9]{4}$" }
    },
    "diagnosticOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullPaths",
        "flatErrors",
        "utf8Output",
        "diagnosticStyle",
        "consoleColorMode",
        "lcid",
        "preferredUILanguage",
        "testParserErrorRecovery",
        "standardOutputRedirected",
        "standardErrorRedirected"
      ],
      "properties": {
        "fullPaths": { "type": "boolean" },
        "flatErrors": { "type": "boolean" },
        "utf8Output": { "type": "boolean" },
        "diagnosticStyle": { "enum": ["default", "visual-studio", "gcc", "rich", "flat"] },
        "consoleColorMode": { "enum": ["automatic", "enabled", "disabled"] },
        "lcid": { "type": ["integer", "null"], "minimum": 0 },
        "preferredUILanguage": { "type": ["string", "null"], "minLength": 1 },
        "testParserErrorRecovery": { "type": "boolean" },
        "standardOutputRedirected": { "type": "boolean" },
        "standardErrorRedirected": { "type": "boolean" }
      }
    },
    "diagnosticStage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "command-line" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "phase"],
          "properties": {
            "kind": { "const": "compilation" },
            "phase": {
              "enum": [
                "source",
                "syntax",
                "resolved-symbols",
                "typed-declarations",
                "lowered-code",
                "optimized-code",
                "symbolic-emission",
                "final-linking"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "publication" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "host" } }
        }
      ]
    },
    "diagnosticRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnosticRawBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "length", "sha256"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "diagnosticRelatedInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "logicalPath", "range"],
      "properties": {
        "message": { "type": "string" },
        "logicalPath": { "type": ["string", "null"], "pattern": "^/[^\\\\]+$" },
        "range": {
          "oneOf": [
            { "$ref": "#/$defs/diagnosticRange" },
            { "type": "null" }
          ]
        }
      }
    },
    "diagnosticOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence",
        "code",
        "numericCode",
        "subcategory",
        "stage",
        "originalSeverity",
        "effectiveSeverity",
        "disposition",
        "suppression",
        "message",
        "logicalPath",
        "materializedPath",
        "range",
        "relatedInformation",
        "suggestions",
        "recoveryGroup",
        "parentOccurrence",
        "rawBytes",
        "stream"
      ],
      "properties": {
        "occurrence": { "type": "integer", "minimum": 0 },
        "code": { "type": "string", "pattern": "^FS[0-9]{4}$" },
        "numericCode": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "subcategory": { "type": ["string", "null"] },
        "stage": { "$ref": "#/$defs/diagnosticStage" },
        "originalSeverity": { "enum": ["information", "warning", "error"] },
        "effectiveSeverity": { "enum": ["hidden", "information", "warning", "error"] },
        "disposition": { "enum": ["emitted", "suppressed"] },
        "suppression": {
          "type": ["string", "null"],
          "enum": [
            null,
            "warning-level",
            "global-nowarn",
            "local-nowarn",
            "off-by-default",
            "language-feature",
            "maximum-errors",
            "abort-boundary"
          ]
        },
        "message": { "type": "string" },
        "logicalPath": { "type": ["string", "null"], "pattern": "^/[^\\\\]+$" },
        "materializedPath": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "range": {
          "oneOf": [
            { "$ref": "#/$defs/diagnosticRange" },
            { "type": "null" }
          ]
        },
        "relatedInformation": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnosticRelatedInformation" }
        },
        "suggestions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recoveryGroup": { "type": ["string", "null"], "minLength": 1 },
        "parentOccurrence": { "type": ["integer", "null"], "minimum": 0 },
        "rawBytes": {
          "oneOf": [
            { "$ref": "#/$defs/diagnosticRawBytes" },
            { "type": "null" }
          ]
        },
        "stream": { "type": ["string", "null"], "enum": [null, "stdout", "stderr"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "suppressed" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "effectiveSeverity": { "const": "hidden" },
              "suppression": { "type": "string" },
              "rawBytes": { "type": "null" },
              "stream": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "emitted" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "effectiveSeverity": { "enum": ["information", "warning", "error"] },
              "suppression": { "type": "null" },
              "rawBytes": { "$ref": "#/$defs/diagnosticRawBytes" },
              "stream": { "enum": ["stdout", "stderr"] }
            }
          }
        }
      ]
    },
    "stringHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "caseId", "attempt", "parentRunId", "recordedAt", "contractHashes"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "caseId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "parentRunId": { "type": ["string", "null"] },
        "recordedAt": { "type": "string", "format": "date-time" },
        "contractHashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stringHash" } }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "rid", "architecture", "sdkVersion", "sdkCommit", "tools", "culture", "encoding", "environmentHash"],
      "properties": {
        "operatingSystem": { "type": "string" },
        "rid": { "type": "string" },
        "architecture": { "type": "string" },
        "sdkVersion": { "const": "10.0.110" },
        "sdkCommit": { "const": "f7d90799ce4ef09a0bb257852a57248d2a8fb8dd" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "culture": { "type": "string" },
        "encoding": { "type": "string" },
        "environmentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolvedCaseHash", "sources", "references", "optionsHash", "packageLocks", "materializedHash"],
      "properties": {
        "resolvedCaseHash": { "$ref": "#/$defs/hash" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "references": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "optionsHash": { "$ref": "#/$defs/hash" },
        "packageLocks": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "materializedHash": { "$ref": "#/$defs/hash" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "status", "inputFingerprint", "outputFingerprint", "traces"],
      "properties": {
        "phase": { "type": "string" },
        "status": { "enum": ["completed", "failed", "unsupported", "not-run"] },
        "inputFingerprint": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "outputFingerprint": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "traces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coreEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "outcome", "diagnostics", "artifacts", "fingerprints", "phases", "traces"],
      "properties": {
        "contractVersion": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["succeeded", "failed", "unsupported", "cancelled"] },
        "diagnostics": { "type": "array", "items": { "type": "string" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "fingerprints": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "phases": { "type": "array", "items": { "$ref": "#/$defs/phase" } },
        "traces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilerSelection", "rootHash", "evaluationHash", "invocationHash", "processHash", "cleanupHash"],
      "properties": {
        "compilerSelection": { "type": "string" },
        "rootHash": { "$ref": "#/$defs/hash" },
        "evaluationHash": { "$ref": "#/$defs/hash" },
        "invocationHash": { "$ref": "#/$defs/hash" },
        "processHash": { "$ref": "#/$defs/hash" },
        "cleanupHash": { "$ref": "#/$defs/hash" }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle", "fsharp2"],
      "properties": {
        "oracle": { "$ref": "#/$defs/lane" },
        "fsharp2": { "$ref": "#/$defs/lane" }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostics", "artifacts", "probes", "runtime", "consumer", "il", "metadata", "pdb", "determinism"],
      "properties": {
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "probes": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "runtime": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "consumer": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "il": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "metadata": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "pdb": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } },
        "determinism": { "type": "array", "items": { "$ref": "#/$defs/stringHash" } }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparatorId", "version", "class", "rawHashes", "canonicalValues", "rule", "passed", "difference"],
      "properties": {
        "comparatorId": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "class": { "enum": ["exact", "normalized", "canonical-semantic", "behavioral", "within-compiler-exact"] },
        "rawHashes": { "type": "array", "items": { "$ref": "#/$defs/hash" } },
        "canonicalValues": { "type": "array", "items": { "type": "string" } },
        "rule": { "type": "string" },
        "passed": { "type": "boolean" },
        "difference": { "type": ["string", "null"] }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasons", "missingEvidence", "bundleHash"],
      "properties": {
        "state": { "enum": ["pass", "fail", "unsupported", "infra-error"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "missingEvidence": { "type": "array", "items": { "type": "string" } },
        "bundleHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
