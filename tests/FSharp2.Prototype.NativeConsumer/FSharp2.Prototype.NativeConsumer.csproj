<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup Condition="'$(FSharp2TracerAssembly)' != ''">
    <Reference Include="Tracer">
      <HintPath>$(FSharp2TracerAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireFSharp2TracerAssembly" BeforeTargets="CoreCompile" Condition="'$(FSharp2TracerAssembly)' == ''">
    <Error Text="Set FSharp2TracerAssembly to the FSharp2-emitted Tracer.dll." />
  </Target>
</Project>
