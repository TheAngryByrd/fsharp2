<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>FSharp2.Compiler.Core</AssemblyName>
    <RootNamespace>FSharp2.Compiler</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>false</PublishAot>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="fsharp2.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../fsc2.Prototype/Resources/Diagnostics*.resx"
                      Link="Resources/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../fsc2.Prototype/Contracts.fs" Link="Contracts.fs" />
    <Compile Include="../fsc2.Prototype/Model.fs" Link="Model.fs" />
    <Compile Include="../fsc2.Prototype/Diagnostics.fs" Link="Diagnostics.fs" />
    <Compile Include="../fsc2.Prototype/SourceText.fs" Link="SourceText.fs" />
    <Compile Include="../fsc2.Prototype/LanguageVersion.fs" Link="LanguageVersion.fs" />
    <Compile Include="../fsc2.Prototype/Lexer.fs" Link="Lexer.fs" />
    <Compile Include="../fsc2.Prototype/Directives.fs" Link="Directives.fs" />
    <Compile Include="../fsc2.Prototype/CommandLine.fs" Link="CommandLine.fs" />
    <Compile Include="../fsc2.Prototype/Frontend.fs" Link="Frontend.fs" />
    <Compile Include="../fsc2.Prototype/ReferenceModel.fs" Link="ReferenceModel.fs" />
    <Compile Include="../fsc2.Prototype/Ecma335ReferenceImporter.fs" Link="Ecma335ReferenceImporter.fs" />
    <Compile Include="../fsc2.Prototype/ReferenceIndex.fs" Link="ReferenceIndex.fs" />
    <Compile Include="../fsc2.Prototype/CompilerService.fs" Link="CompilerService.fs" />
    <Compile Include="../fsc2.Prototype/SymbolicEmission.fs" Link="SymbolicEmission.fs" />
    <Compile Include="../fsc2.Prototype/StrongName.fs" Link="StrongName.fs" />
    <Compile Include="../fsc2.Prototype/Linker.fs" Link="Linker.fs" />
    <Compile Include="../fsc2.Prototype/CompilationPipeline.fs" Link="CompilationPipeline.fs" />
    <Compile Include="../fsc2.Prototype/Compiler.fs" Link="Compiler.fs" />
    <Compile Include="../fsc2.Prototype/ServiceHost.fs" Link="ServiceHost.fs" />
    <Compile Include="CompilerHost.fs" />
  </ItemGroup>
</Project>
